@page "/"

<PageTitle>Home</PageTitle>

<h1>Jogo dos pares</h1>

<style>
    .container {
        width: 400px;
    }

    button {
        width: 100px;
        height: 100px;
        font-size: 50px;
    }
</style>
<div class="container">
    <div class="row">
        @foreach (var emoji in shuffledEmoji)
        {
            <div class="col-3">
                <button type="button" class="btn btn-outline-dark"><h1>@emoji</h1></button>
            </div>
        }
    </div>
</div>
@code {
    List<string> animalEmoji = new()
    {
        "🐶","🐶","🐵","🐵","🐱","🐱","🐹","🐹","🐰","🐰","🐮","🐮","🐷","🐷","🐸","🐸",
    };

    List<string> shuffledEmoji = new();
    protected override void OnInitialized()
    {
        var rnd = new Random();
        shuffledEmoji = animalEmoji.OrderBy(x => rnd.Next()).ToList();
    }
}