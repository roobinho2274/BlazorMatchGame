@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Jogo dos pares</h1>

<style>
    .container {
        width: 400px;
    }

    button {
        width: 100px;
        height: 100px;
        font-size: 50px;
    }
</style>
<div class="container">
    <div class="row">
        @for (var animalNumber = 0; animalNumber < shuffledEmoji.Count; animalNumber++)
        {
            var animal = shuffledEmoji[animalNumber];
            var uniqueAnimalDescription = $"Animal {animalNumber}";
           
            <div class="col-3">
                <button @onclick="() => ButtonClick(animal, uniqueAnimalDescription)" type="button" class="btn btn-outline-dark"><h1>@animal</h1></button>
            </div>
        }
    </div>
    <div class="row">
        <h2>Pares encontrados: @machFound</h2>
    </div>
</div>
@code {

    int machFound = 0;
    List<string> animalEmoji = new()
    {
        "🐶","🐶","🐵","🐵","🐱","🐱","🐹","🐹","🐰","🐰","🐮","🐮","🐷","🐷","🐸","🐸",
    };

    List<string> shuffledEmoji = new();

    protected override void OnInitialized()
    {
        var rnd = new Random();
        shuffledEmoji = animalEmoji.OrderBy(x => rnd.Next()).ToList();
        machFound = 0;
    }

    string lastAnimalFound = string.Empty;
    string lastAnimalDescription = string.Empty;

    private void ButtonClick(string animal, string animalDescription)
    {
        if (lastAnimalFound == string.Empty)
        {
            lastAnimalFound = animal;
            lastAnimalDescription = animalDescription;
        }
        else if (lastAnimalFound == animal && lastAnimalDescription != animalDescription)
        {
            lastAnimalFound = string.Empty;
            shuffledEmoji = shuffledEmoji
            .Select(x => x.Replace(animal, string.Empty))
            .ToList();

            machFound++;
            if(machFound == animalEmoji.Count / 2)
            {
                OnInitialized();
            };
        }
        else
        {
            lastAnimalFound = string.Empty;
        }
    }
}